pipeline {
    agent none
    environment {
        registry = '13.213.82.69/hangfireservice/hangfireservice'
        pulumi_env = 'DEV'
        pulumi_project = 'Hangfire'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -f ./HangfireService/Dockerfile -t ${registry}:${version} .'
                sh 'sudo docker push ${registry}:${version}'
                sh 'sudo docker rmi ${registry}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'Build' } }
            steps {
                sh 'cd ${env.ECS_Deploy_Path}'

                sh 'aws configure set aws_access_key_id ${env.AWS_AILAB_EC2_AccessKey}'
                sh 'aws configure set aws_secret_access_key ${env.AWS_AILAB_EC2_SecretKey}'
                sh 'aws configure set region ap-southeast-1'
                sh 'aws configure set output json'

                sh 'dotnet run ${pulumi_env} ${pulumi_project} ${version}'                
            }
        }
    }
}
