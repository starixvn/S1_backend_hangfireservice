{

  "Env": "Development",
  "ServiceType": "Worker", // API/Worker
  "ServiceName": "ThirdPartyWager",
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "ConfigService": [ "https://s1-config-service.nexdev.net/hangfire" ],
  "OpenSearch": {
    "Uri": "logstash.nexdev.net",
    "Port": 31853
  }
}