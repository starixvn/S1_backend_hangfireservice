{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Hangfire": "Information"
        }
    },
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "Enrich": [ "WithHangfireContext" ],
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "e:/logs/hangfire/hangfire-.log",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 60,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true,
                    "restrictedToMinimumLevel": "Warning"
                }
            },
            {
                "Name": "Console"
            },
            {
                "Name": "Hangfire"
            }
        ]
    },
    "ExcludesMessage": [
        "/health"
    ],
    "ExcludesApiEndpoint": [
        "/health"
    ],
    "AllowedHosts": "*",
    "Kestrel": {
        "EndPoints": {
            "Http": {
                "Url": "http://*:45678"
            }
        }
    },
    "AdminSiteUrl": "http://admin.n88dev.com/",
    "Jobs": [
        {
            "Type": "IScheduledJob",
            "ClassName": "LiveJob",
            "JobName": "LiveJob",
            "Group": "common",
            "Description": "Health Check",
            "Cron": "* * * * *", //Execute every minute
            "Enable": true
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "TpNotImplementedJob",
            "JobName": "Detail.TpNotImplemented",
            "Group": "common",
            "Description": "Update NotImplemented Tp to Success.",
            "Cron": "*/30 * * * * *", //Execute every 30 seconds
            "Enable": true,
            "Parameters": [ "1", "14" ] //Implemented TpId
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "TodoStatusResetJob",
            "JobName": "Detail.TodoStatusReset",
            "Group": "common",
            "Description": "Reset todo status is 0.",
            "Cron": "0 * * * *", //Execute every hour
            "Enable": true
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "TpDetailJob",
            "JobName": "Detail.Saba",
            "Group": "TpDetail",
            "Description": "Get Saba Bet Record Detail.",
            "Cron": "*/15 * * * * *", //Execute every 15 seconds
            "Enable": true,
            "Parameters": [ "1" ] // TpId
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "TpDetailJob",
            "JobName": "Detail.PG",
            "Group": "TpDetail",
            "Description": "Get PG Bet Record Detail.",
            "Cron": "0/3 * * * *", //Execute every 3 minute
            "Enable": true,
            "Parameters": [ "14" ] // TpId
        }
    ]
}
