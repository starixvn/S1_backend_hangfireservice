{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Hangfire": "Information"
        }
    },
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "Enrich": [ "WithHangfireContext" ],
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "e:/logs/hangfire/hangfire-.log",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 60,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true,
                    "restrictedToMinimumLevel": "Information"
                }
            },
            {
                "Name": "Console"
            },
            {
                "Name": "Hangfire"
            }
        ]
    },
    "ExcludesMessage": [
        "/health"
    ],
    "ExcludesApiEndpoint": [
        "/health"
    ],
    "AllowedHosts": "*",
    "Jobs": [
        {
            "Type": "IScheduledJob",
            "ClassName": "LiveJob",
            "JobName": "LiveJob",
            "Group": "common",
            "Description": "Health Check",
            "Cron": "*/30 * * * * *",
            "Enable": true
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "DetailStatementJob",
            "JobName": "DetailStatementJob",
            "Group": "betrecord",
            "Description": "從Todo取出交易單號，送往第三方取得明細",
            "Cron": "*/15 * * * * *",
            "Enable": true
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "FailDetailStatementJob",
            "JobName": "FailDetailStatementJob",
            "Group": "betrecord",
            "Description": "將Todo內執行失敗狀態為-1的再次執行",
            //"Cron": "0 * * * *",
            "Cron": "*/15 * * * * *",
            "Enable": true,
            "StringParams": [ "-1", "-2", "-3" ]
        }
    ],
    "AdminSiteUrl": "http://admin.n88dev.com/"
}
