{
  "ConfigService": "https://localhost:7242/config",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "Enrich": [ "WithHangfireContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "e:/logs/hangfire/hangfire-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "Console"
      },
      {
        "Name": "Hangfire"
      }
    ]
  },
  "ExcludesMessage": [
    "/health"
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:45678"
      }
    }
  },
  "ScheduledJob": {
    "TpDetail": [
      {
        "Type": "IScheduledJob",
        "ClassName": "TpNotImplementedJob",
        "JobName": "TpDetail.TpNotImplemented",
        "Description": "Delete TpDetailTodo NotImplemented Tp.",
        "Cron": "* * * * *", //Execute every minute
        "Enable": true,
        "Parameters": [ 1, 14 ] //Implemented TpId
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "TodoStatusResetJob",
        "JobName": "TpDetail.TodoStatusReset",
        "Description": "Reset todo status is 0.",
        "Cron": "0 * * * *", //Execute every hour
        "Enable": true
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "TpDetailJob",
        "JobName": "TpDetail.Saba",
        "Description": "Get Saba Bet Record Detail.",
        "Cron": "*/15 * * * * *", //Execute every 15 seconds
        "Enable": true,
        "Parameters": [ 1 ] // TpId
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "TpDetailJob",
        "JobName": "TpDetail.PG",
        "Description": "Get PG Bet Record Detail.",
        "Cron": "0/3 * * * *", //Execute every 3 minute
        "Enable": true,
        "Parameters": [ 14 ] // TpId
      }
    ],
    "Archive": [
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.PG",
        "Description": "Archive BettransRng PG",
        "Cron": "0 4 * * *", //Execute at 04:00 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "04:00",
          "EndTime": "07:00",
          "LiminNum": 1000,
          "ColdDownTime": 1,
          "GetSP": "Archive_BettransRng_PG_Get",
          "InsertSP": "Archive_BettransRng_PG14_Ins",
          "DeleteSP": "Archive_BettransRng_PG_Del"
        }
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.PP",
        "Description": "Archive BettransRng PP",
        "Cron": "40 5 * * *", //Execute at 05:40 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "05:40",
          "EndTime": "07:40",
          "LiminNum": 1000,
          "ColdDownTime": 1,
          "GetSP": "Archive_bettransrng_pp_Get",
          "InsertSP": "Archive_bettransrng_pp14_Ins",
          "DeleteSP": "Archive_bettransrng_pp_Del"
        }
      }
    ]
  }
}
