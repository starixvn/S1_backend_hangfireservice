{
  "Env": "Development",
  "ServiceType": "Worker", // API/Worker
  "ServiceName": "ThirdPartyWager",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "Enrich": [ "WithHangfireContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/hangfire/hangfire-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Hangfire",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "ExcludesMessage": [
    "/health",
    "Received HTTP response headers after {ElapsedMilliseconds}ms - {StatusCode}",
    "End processing HTTP request after {ElapsedMilliseconds}ms - {StatusCode}",
    "Start processing HTTP request {HttpMethod} {Uri}",
    "Sending HTTP request {HttpMethod} {Uri}",
    "{HostingRequestFinishedLog:l}",
    "{HostingRequestStartingLog:l}"
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:5000"
      }
    }
  },
  "ConfigService": [ "https://s1-config-service.nexdev.net/hangfire" ],
  "Sentry": {
    "Dsn": "https://932f6035127bf2ca4a97269a8f500a7d@sentry-s1.nexentgame.com/16",
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always",
    "MinimumBreadcrumbLevel": "Debug",
    "MinimumEventLevel": "Error",
    "AttachStackTrace": true,
    "Debug": true,
    "DiagnosticLevel": "Error",
    "TracesSampleRate": 1.0,
    "Environment": "DEV"
  },
  "OpenSearch": {
    "Uri": "logstash.nexdev.net",
    "Port": 31853
  }
}
