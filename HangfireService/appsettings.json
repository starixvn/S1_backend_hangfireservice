{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "Enrich": [ "WithHangfireContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/logs/hangfire/hangfire-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Hangfire",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "ExcludesMessage": [
    "/health"
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:45678"
      }
    }
  },
  "ScheduledJob": {
    "TpDetail": [
      {
        "Type": "IScheduledJob",
        "ClassName": "TpNotImplementedJob",
        "JobName": "TpDetail.TpNotImplemented",
        "Description": "Delete TpDetailTodo NotImplemented Tp.",
        "Cron": "* * * * *", //Execute every minute
        "Enable": true,
        "Parameters": [ 1, 14 ] //Implemented TpId
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "TodoStatusResetJob",
        "JobName": "TpDetail.TodoStatusReset",
        "Description": "Reset todo status is 0.",
        "Cron": "0 * * * *", //Execute every hour
        "Enable": true
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "TpDetailJob",
        "JobName": "TpDetail.Saba",
        "Description": "Get Saba Bet Record Detail.",
        "Cron": "* * * * *", //Execute every minute
        "Enable": true,
        "Parameters": [ 1 ] // TpId
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "TpDetailJob",
        "JobName": "TpDetail.PG",
        "Description": "Get PG Bet Record Detail.",
        "Cron": "0/3 * * * *", //Execute every 3 minute
        "Enable": true,
        "Parameters": [ 14 ] // TpId
      }
    ],
    "Archive": [
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.TpBetRecord",
        "Description": "Archive TpBetRecord",
        "Cron": "30 8 * * *", //Execute at 08:30 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "00:00",
          "EndTime": "23:59",
          "LiminNum": 1000,
          "ColdDownTime": 1,
          "GetSP": "Archive_TpBetRecord_Get",
          "InsertSP": "Archive_TpBetRecord14_Ins",
          "DeleteSP": "Archive_TpBetRecord_Del"
        }
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.PP",
        "Description": "Archive BettransRng PP",
        "Cron": "40 5 * * *", //Execute at 05:40 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "00:00",
          "EndTime": "23:59",
          "LiminNum": 10,
          "ColdDownTime": 1,
          "GetSP": "Archive_bettransrng_pp_Get",
          "InsertSP": "Archive_bettransrng_pp14_Ins",
          "DeleteSP": "Archive_bettransrng_pp_Del"
        }
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.SG",
        "Description": "Archive BettransRng SG",
        "Cron": "45 5 * * *", //Execute at 05:45 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "00:00",
          "EndTime": "23:59",
          "LiminNum": 10,
          "ColdDownTime": 1,
          "GetSP": "Archive_BettransRng_SG_Get",
          "InsertSP": "Archive_BettransRng_SG_Ins",
          "DeleteSP": "Archive_BettransRng_SG_Del"
        }
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.PG",
        "Description": "Archive BettransRng PG",
        "Cron": "0 4 * * *", //Execute at 04:00 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "00:00",
          "EndTime": "23:59",
          "LiminNum": 10,
          "ColdDownTime": 1,
          "GetSP": "Archive_BettransRng_PG_Get",
          "InsertSP": "Archive_BettransRng_PG14_Ins",
          "DeleteSP": "Archive_BettransRng_PG_Del"
        }
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.GPI",
        "Description": "Archive BettransRng GPI",
        "Cron": "55 5 * * *", //Execute at 05:55 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "00:00",
          "EndTime": "23:59",
          "LiminNum": 10,
          "ColdDownTime": 1,
          "GetSP": "Archive_BettransRng_GPI_Get",
          "InsertSP": "Archive_BettransRng_GPI14_Ins",
          "DeleteSP": "Archive_BettransRng_GPI_Del"
        }
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.TpSlotsBonus",
        "Description": "Delete old TpSlotsBonus",
        "Cron": "0 6 * * *", //Execute at 06:00 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "00:00",
          "EndTime": "23:59",
          "LiminNum": 10,
          "ColdDownTime": 1,
          "GetSP": "Archive_TpSlotsBonus_Get",
          "InsertSP": "", // empty is only delete old data.
          "DeleteSP": "Archive_TpSlotsBonus_Del"
        }
      },
      {
        "Type": "IScheduledJob",
        "ClassName": "ArchiveJob",
        "JobName": "Archive.CQ9",
        "Description": "Archive BettransRng CQ9",
        "Cron": "5 6 * * *", //Execute at 06:05 (UTC+8) every day
        "Enable": true,
        "Parameters": {
          "StartTime": "00:00",
          "EndTime": "23:59",
          "LiminNum": 10,
          "ColdDownTime": 1,
          "GetSP": "Archive_BettransRNG_CQ9_Get",
          "InsertSP": "Archive_BettransRNG_CQ914_Ins",
          "DeleteSP": "Archive_BettransRNG_CQ9_Del"
        }
      }
    ]
  }
}
