{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Hangfire": "Information"
        }
    },
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "Enrich": [ "WithHangfireContext" ],
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "e:/logs/hangfire/hangfire-.log",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 60,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true,
                    "restrictedToMinimumLevel": "Information"
                }
            },
            {
                "Name": "Console"
            },
            {
                "Name": "Hangfire"
            }
        ]
    },
    "ExcludesMessage": [
        "/health"
    ],
    "ExcludesApiEndpoint": [
        "/health"
    ],
    "AllowedHosts": "*",
    "Jobs": [
        {
            "Type": "IScheduledJob",
            "Name": "LiveJob",
            "Group": "common",
            "Description": "Live",
            "Cron": "*/15 * * * * *",
            "Enable": true
        },
        {
            "Type": "IScheduledJob",
            "Name": "DetailStatementJob",
            "Group": "betrecord",
            "Description": "Get Detail Statement",
            "Cron": "*/15 * * * * *",
            "Enable": true
        }
    ]
}
