{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "Hangfire": "Information"
        }
    },
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "Enrich": [ "WithHangfireContext" ],
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "e:/logs/hangfire/hangfire-.log",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 60,
                    "fileSizeLimitBytes": 10485760,
                    "rollOnFileSizeLimit": true,
                    "restrictedToMinimumLevel": "Warning"
                }
            },
            {
                "Name": "Console"
            },
            {
                "Name": "Hangfire"
            }
        ]
    },
    "ExcludesMessage": [
        "/health"
    ],
    "ExcludesApiEndpoint": [
        "/health"
    ],
    "AllowedHosts": "*",
    "Kestrel": {
        "EndPoints": {
            "Http": {
                "Url": "http://*:45678"
            }
        }
    },
    "AdminSiteUrl": "http://admin.n88dev.com/",
    "Jobs": [
        {
            "Type": "IScheduledJob",
            "ClassName": "LiveJob",
            "JobName": "LiveJob",
            "Group": "common",
            "Description": "Health Check",
            "Cron": "* * * * *", //Execute every minute
            "Enable": true
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "DetailStatementJob",
            "JobName": "Detail.Job",
            "Group": "betrecord",
            "Description": "Get All Tp Bet detail from Tp API.",
            "Cron": "*/15 * * * * *", //Execute every 15 seconds
            "Enable": true
        },
        {
            "Type": "IScheduledJob",
            "ClassName": "DetailStatementJob",
            "JobName": "Detail.RetryFail.Job",
            "Group": "betrecord",
            "Description": "Retry todo status is -1.",
            "Cron": "0 * * * *", //Execute every hour
            "Enable": true,
            "Parameters": [ "-1" ] //Optional
        }
    ]
}
